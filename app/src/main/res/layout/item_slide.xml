<?xml version="1.0" encoding="utf-8"?>
<!-- 画像・PDF / Webページ / スライド の一覧で共通に使う行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/rowEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rowThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="#22000000"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/rowMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/rowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowUp"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ss_move_up"
        android:visibility="gone"
        app:icon="@drawable/ic_arrow_up" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowDown"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ss_move_down"
        android:visibility="gone"
        app:icon="@drawable/ic_arrow_down" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowAdd"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ss_add_to_slideshow"
        android:visibility="gone"
        app:icon="@drawable/ic_playlist_add" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowEdit"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ss_edit"
        app:icon="@drawable/ic_edit" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowDelete"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/delete"
        app:icon="@drawable/ic_delete" />
</LinearLayout>
